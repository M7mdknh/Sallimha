# Copy to .env for local development. Names only — never commit real values.
# Staging/production values live in the hosting provider's secret store.

# local | test | staging | production. Anything other than local/test refuses dev defaults.
SALLIMHA_ENV=local
DJANGO_SETTINGS_MODULE=sallimha.settings
DJANGO_SECRET_KEY=
# Comma-separated previous Django keys during a rotation (docs/runbooks/secret-rotation.md)
DJANGO_SECRET_KEY_FALLBACKS=
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
# Number of reverse proxies that append X-Forwarded-For (0 = none). Required outside local/test.
TRUSTED_PROXY_COUNT=
LOG_LEVEL=INFO
DATABASE_URL=postgres://sallimha:sallimha-local-only@127.0.0.1:55432/sallimha

# Field encryption (Fernet, urlsafe base64 32 bytes) and keyed-hash secret
FIELD_ENCRYPTION_KEY=
HASH_KEY=
# Previous keys during a rotation only (manage.py rotate_keys); empty otherwise
FIELD_ENCRYPTION_KEYS_PREVIOUS=
HASH_KEY_PREVIOUS=

# Private media directory (never under a web-served path)
MEDIA_ROOT_PRIVATE=var/media

# WhatsApp transport: "fake" (local simulator, results labelled SIMULATED) or "cloud"
WHATSAPP_TRANSPORT=fake
WHATSAPP_APP_SECRET=
WHATSAPP_APP_SECRET_PREVIOUS=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# Development simulator (must be 0 outside local/dev)
SIMULATOR_ENABLED=1

# --- staging/production only (infra/staging/README.md); names only, values live in the secret store ---
# Private evidence storage: local (development) or s3 (private S3-compatible bucket)
MEDIA_STORAGE=local
MEDIA_S3_BUCKET=
MEDIA_S3_REGION=
MEDIA_S3_ENDPOINT_URL=
MEDIA_S3_SSE=AES256
MEDIA_S3_ADDRESSING_STYLE=
# HTTPS hardening (outside local/test). Start HSTS small; raise once HTTPS is confirmed for the whole domain.
SECURE_HSTS_SECONDS=
SECURE_HSTS_INCLUDE_SUBDOMAINS=0
SECURE_HSTS_PRELOAD=0
# Built console directory served from the API origin (the image sets /app/console)
CONSOLE_DIST=
